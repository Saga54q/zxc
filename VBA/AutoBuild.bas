' ============================================================================
'  ЭТАП 7. ЗАПРОСЫ
' ============================================================================

Private Sub СоздатьЗапросы()
    Dim db As DAO.Database
    Dim qd As DAO.QueryDef
    Set db = CurrentDb

    ' Q01_СвободныеТалоны — Выборка с параметрами. Свободные талоны к врачу по выбранной
    ' специальности на выбранную дату (специфика задания). Талоны, занятые записью со статусом
    ' «Отменён», снова считаются свободными. Параметры: [Введите специальность], [Введите дату
    ' приёма].
    On Error Resume Next
    db.QueryDefs.Delete "Q01_СвободныеТалоны"
    On Error GoTo 0
    Set qd = db.CreateQueryDef("Q01_СвободныеТалоны", "PARAMETERS [Введите специальность] Text ( 255 ), [Введите дату приёма] DateTime; SELECT Специальности.НазваниеСпециальности AS Специальность, [Врачи].[Фамилия] & ' ' & Left([Врачи].[Имя], 1) & '. ' & Left([Врачи].[Отчество], 1) & '.' AS Врач, РасписаниеПриёма.ДатаПриёма AS Дата, РасписаниеПриёма.ВремяНачала AS Начало, РасписаниеПриёма.ВремяОкончания AS Окончание, РасписаниеПриёма.Кабинет AS Каб, РасписаниеПриёма.КодРасписания AS КодСлота FROM (РасписаниеПриёма INNER JOIN Врачи ON РасписаниеПриёма.КодВрача = Врачи.КодВрача) INNER JOIN Специальности ON Врачи.КодСпециальности = Специальности.КодСпециальности WHERE Специальности.НазваниеСпециальности = [Введите специальность] AND РасписаниеПриёма.ДатаПриёма = [Введите дату приёма] AND РасписаниеПриёма.ПризнакПриёма = True AND NOT EXISTS (SELECT 1 FROM ЗаписиНаПриём WHERE ЗаписиНаПри" & _
        "ём.КодРасписания = РасписаниеПриёма.КодРасписания AND ЗаписиНаПриём.СтатусЗаписи <> 'Отменён') ORDER BY Врачи.Фамилия, РасписаниеПриёма.ВремяНачала")
    AddProp qd, "Description", dbText, "Свободные талоны к врачу по выбранной специальности на выбранную дату (специфика задания). Талоны, занятые записью со статусом «Отменён», снова считаются свободными."
    qd.Close

    ' Q02_ИсторияПосещенийПациента — Параметрический. История посещений пациента по фамилии
    ' (специфика задания): приёмы, врачи, специальности, статусы, основной диагноз. Параметры:
    ' [Введите фамилию пациента].
    On Error Resume Next
    db.QueryDefs.Delete "Q02_ИсторияПосещенийПациента"
    On Error GoTo 0
    Set qd = db.CreateQueryDef("Q02_ИсторияПосещенийПациента", "PARAMETERS [Введите фамилию пациента] Text ( 255 ); SELECT [Пациенты].[Фамилия] & ' ' & [Пациенты].[Имя] & ' ' & [Пациенты].[Отчество] AS Пациент, ЗаписиНаПриём.НомерТалона AS [№ талона], ЗаписиНаПриём.ДатаПриёма AS Дата, ЗаписиНаПриём.ВремяПриёма AS Время, [Врачи].[Фамилия] & ' ' & Left([Врачи].[Имя], 1) & '. ' & Left([Врачи].[Отчество], 1) & '.' AS Врач, Специальности.НазваниеСпециальности AS Специальность, ЗаписиНаПриём.СтатусЗаписи AS Статус, (SELECT First(Диагнозы.КодМКБ) FROM Диагнозы WHERE Диагнозы.КодЗаписи = ЗаписиНаПриём.КодЗаписи AND Диагнозы.ТипДиагноза = 'Основной') AS [Код МКБ], ЗаписиНаПриём.Жалобы AS Жалобы FROM ((ЗаписиНаПриём INNER JOIN Пациенты ON ЗаписиНаПриём.КодПациента = Пациенты.КодПациента) INNER JOIN Врачи ON ЗаписиНаПриём.КодВрача = Врачи.КодВрача) INNER JOIN Специальности ON Врачи.КодСпециальности = С" & _
        "пециальности.КодСпециальности WHERE Пациенты.Фамилия = [Введите фамилию пациента] ORDER BY ЗаписиНаПриём.ДатаПриёма DESC, ЗаписиНаПриём.ВремяПриёма DESC")
    AddProp qd, "Description", dbText, "История посещений пациента по фамилии (специфика задания): приёмы, врачи, специальности, статусы, основной диагноз."
    qd.Close

    ' Q03_ЖурналЗаписей — Выборка с вычисляемыми полями. Полный журнал записей на приём с
    ' вычисляемыми полями: ФИО пациента, ФИО врача, возраст пациента, форматированная дата.
    ' Параметры: без параметров.
    On Error Resume Next
    db.QueryDefs.Delete "Q03_ЖурналЗаписей"
    On Error GoTo 0
    Set qd = db.CreateQueryDef("Q03_ЖурналЗаписей", "SELECT ЗаписиНаПриём.НомерТалона AS [№ талона], ЗаписиНаПриём.ДатаПриёма AS Дата, Format([ЗаписиНаПриём].[ДатаПриёма], 'dd.mm.yyyy') AS ДатаТекст, ЗаписиНаПриём.ВремяПриёма AS Время, [Пациенты].[Фамилия] & ' ' & Left([Пациенты].[Имя], 1) & '. ' & Left([Пациенты].[Отчество], 1) & '.' AS Пациент, DateDiff('yyyy', [Пациенты].[ДатаРождения], Date()) AS Возраст, [Врачи].[Фамилия] & ' ' & Left([Врачи].[Имя], 1) & '. ' & Left([Врачи].[Отчество], 1) & '.' AS Врач, Специальности.НазваниеСпециальности AS Специальность, ЗаписиНаПриём.СтатусЗаписи AS Статус FROM ((ЗаписиНаПриём INNER JOIN Пациенты ON ЗаписиНаПриём.КодПациента = Пациенты.КодПациента) INNER JOIN Врачи ON ЗаписиНаПриём.КодВрача = Врачи.КодВрача) INNER JOIN Специальности ON Врачи.КодСпециальности = Специальности.КодСпециальности ORDER BY ЗаписиНаПриём.ДатаПриёма, ЗаписиНаПриём." & _
        "ВремяПриёма")
    AddProp qd, "Description", dbText, "Полный журнал записей на приём с вычисляемыми полями: ФИО пациента, ФИО врача, возраст пациента, форматированная дата."
    qd.Close

    ' Q04_ПациентыСВозрастом — Выборка с вычисляемыми полями. Картотека пациентов с расчётом
    ' возраста и группы диспансерного наблюдения. Параметры: без параметров.
    On Error Resume Next
    db.QueryDefs.Delete "Q04_ПациентыСВозрастом"
    On Error GoTo 0
    Set qd = db.CreateQueryDef("Q04_ПациентыСВозрастом", "SELECT Пациенты.КодПациента AS Код, [Пациенты].[Фамилия] & ' ' & [Пациенты].[Имя] & ' ' & [Пациенты].[Отчество] AS Пациент, Пациенты.ДатаРождения AS [Дата рождения], DateDiff('yyyy', [Пациенты].[ДатаРождения], Date()) AS Возраст, Пациенты.Пол AS Пол, IIf(DateDiff('yyyy', [Пациенты].[ДатаРождения], Date()) >= 60, 'Старшая', IIf(DateDiff('yyyy', [Пациенты].[ДатаРождения], Date()) <= 17, 'Детская', 'Трудоспособная')) AS Группа, Пациенты.НомерПолиса AS [Полис ОМС], Пациенты.Телефон AS Телефон, Пациенты.Участок AS Участок FROM Пациенты ORDER BY Пациенты.Фамилия, Пациенты.Имя")
    AddProp qd, "Description", dbText, "Картотека пациентов с расчётом возраста и группы диспансерного наблюдения."
    qd.Close

    ' Q05_ИтогиПоВрачам — Итоговый. Итоговый запрос: количество принятых пациентов по каждому
    ' врачу (всего, проведено, неявка, отменено). Параметры: без параметров.
    On Error Resume Next
    db.QueryDefs.Delete "Q05_ИтогиПоВрачам"
    On Error GoTo 0
    Set qd = db.CreateQueryDef("Q05_ИтогиПоВрачам", "SELECT [Врачи].[Фамилия] & ' ' & Left([Врачи].[Имя], 1) & '. ' & Left([Врачи].[Отчество], 1) & '.' AS Врач, Специальности.НазваниеСпециальности AS Специальность, Count(ЗаписиНаПриём.КодЗаписи) AS [Всего записей], Sum(IIf([ЗаписиНаПриём].[СтатусЗаписи] = 'Проведён', 1, 0)) AS Проведено, Sum(IIf([ЗаписиНаПриём].[СтатусЗаписи] = 'Неявка', 1, 0)) AS Неявка, Sum(IIf([ЗаписиНаПриём].[СтатусЗаписи] = 'Отменён', 1, 0)) AS Отменено, Sum(IIf([ЗаписиНаПриём].[СтатусЗаписи] = 'Запланирован', 1, 0)) AS Запланировано FROM (Врачи INNER JOIN ЗаписиНаПриём ON Врачи.КодВрача = ЗаписиНаПриём.КодВрача) INNER JOIN Специальности ON Врачи.КодСпециальности = Специальности.КодСпециальности GROUP BY [Врачи].[Фамилия] & ' ' & Left([Врачи].[Имя], 1) & '. ' & Left([Врачи].[Отчество], 1) & '.', Специальности.НазваниеСпециальности ORDER BY Count(ЗаписиНаПриём" & _
        ".КодЗаписи) DESC")
    AddProp qd, "Description", dbText, "Итоговый запрос: количество принятых пациентов по каждому врачу (всего, проведено, неявка, отменено)."
    qd.Close

    ' Q06_ЗагрузкаВрачейЗаПериод — Итоговый с параметрами. Загрузка врачей по специальностям за
    ' выбранный период — источник данных отчёта «Загрузка врачей» (специфика задания). Параметры:
    ' [Начало периода], [Конец периода].
    On Error Resume Next
    db.QueryDefs.Delete "Q06_ЗагрузкаВрачейЗаПериод"
    On Error GoTo 0
    Set qd = db.CreateQueryDef("Q06_ЗагрузкаВрачейЗаПериод", "PARAMETERS [Начало периода] DateTime, [Конец периода] DateTime; SELECT Специальности.НазваниеСпециальности AS Специальность, [Врачи].[Фамилия] & ' ' & Left([Врачи].[Имя], 1) & '. ' & Left([Врачи].[Отчество], 1) & '.' AS Врач, Count(ЗаписиНаПриём.КодЗаписи) AS [Всего талонов], Sum(IIf([ЗаписиНаПриём].[СтатусЗаписи] = 'Проведён', 1, 0)) AS Принято, Sum(IIf([ЗаписиНаПриём].[СтатусЗаписи] = 'Неявка', 1, 0)) AS Неявка, Sum(IIf([ЗаписиНаПриём].[СтатусЗаписи] = 'Отменён', 1, 0)) AS Отменено FROM (ЗаписиНаПриём INNER JOIN Врачи ON ЗаписиНаПриём.КодВрача = Врачи.КодВрача) INNER JOIN Специальности ON Врачи.КодСпециальности = Специальности.КодСпециальности WHERE ЗаписиНаПриём.ДатаПриёма Between [Начало периода] And [Конец периода] GROUP BY Специальности.НазваниеСпециальности, [Врачи].[Фамилия] & ' ' & Left([Врачи].[Имя], 1) & '. ' & Left([" & _
        "Врачи].[Отчество], 1) & '.' ORDER BY Специальности.НазваниеСпециальности, Count(ЗаписиНаПриём.КодЗаписи) DESC")
    AddProp qd, "Description", dbText, "Загрузка врачей по специальностям за выбранный период — источник данных отчёта «Загрузка врачей» (специфика задания)."
    qd.Close

    ' Q07_СтоимостьЛечения — Итоговый с вычисляемыми полями. Стоимость лечения по каждому приёму:
    ' сумма назначенных услуг (вычисляемое поле [Количество] * [Стоимость]). Параметры: без
    ' параметров.
    On Error Resume Next
    db.QueryDefs.Delete "Q07_СтоимостьЛечения"
    On Error GoTo 0
    Set qd = db.CreateQueryDef("Q07_СтоимостьЛечения", "SELECT ЗаписиНаПриём.КодЗаписи AS [Код записи], ЗаписиНаПриём.НомерТалона AS [№ талона], [Пациенты].[Фамилия] & ' ' & Left([Пациенты].[Имя], 1) & '. ' & Left([Пациенты].[Отчество], 1) & '.' AS Пациент, [Врачи].[Фамилия] & ' ' & Left([Врачи].[Имя], 1) & '. ' & Left([Врачи].[Отчество], 1) & '.' AS Врач, ЗаписиНаПриём.ДатаПриёма AS Дата, Count(Назначения.КодНазначения) AS [Услуг назначено], Sum([Назначения].[Количество] * [Услуги].[Стоимость]) AS [Сумма, руб.] FROM (((ЗаписиНаПриём INNER JOIN Назначения ON ЗаписиНаПриём.КодЗаписи = Назначения.КодЗаписи) INNER JOIN Услуги ON Назначения.КодУслуги = Услуги.КодУслуги) INNER JOIN Пациенты ON ЗаписиНаПриём.КодПациента = Пациенты.КодПациента) INNER JOIN Врачи ON ЗаписиНаПриём.КодВрача = Врачи.КодВрача GROUP BY ЗаписиНаПриём.КодЗаписи, ЗаписиНаПриём.НомерТалона, [Пациенты].[Фамилия] & ' ' " & _
        "& Left([Пациенты].[Имя], 1) & '. ' & Left([Пациенты].[Отчество], 1) & '.', [Врачи].[Фамилия] & ' ' & Left([Врачи].[Имя], 1) & '. ' & Left([Врачи].[Отчество], 1) & '.', ЗаписиНаПриём.ДатаПриёма ORDER BY Sum([Назначения].[Количество] * [Услуги].[Стоимость]) DESC")
    AddProp qd, "Description", dbText, "Стоимость лечения по каждому приёму: сумма назначенных услуг (вычисляемое поле [Количество] * [Стоимость])."
    qd.Close

    ' Q08_АрхивацияЗаписей — На добавление (INSERT INTO … SELECT). Переносит прошедшие приёмы
    ' (датой ранее текущей и статусом «Проведён» или «Неявка») в таблицу АрхивЗаписей. Параметры:
    ' без параметров.
    On Error Resume Next
    db.QueryDefs.Delete "Q08_АрхивацияЗаписей"
    On Error GoTo 0
    Set qd = db.CreateQueryDef("Q08_АрхивацияЗаписей", "INSERT INTO АрхивЗаписей ( КодЗаписи, НомерТалона, КодПациента, КодВрача, ДатаПриёма, ВремяПриёма, СтатусЗаписи, Жалобы, ДатаАрхивации ) SELECT ЗаписиНаПриём.КодЗаписи, ЗаписиНаПриём.НомерТалона, ЗаписиНаПриём.КодПациента, ЗаписиНаПриём.КодВрача, ЗаписиНаПриём.ДатаПриёма, ЗаписиНаПриём.ВремяПриёма, ЗаписиНаПриём.СтатусЗаписи, ЗаписиНаПриём.Жалобы, Date() AS ДатаАрхивации FROM ЗаписиНаПриём WHERE ЗаписиНаПриём.ДатаПриёма < Date() AND ЗаписиНаПриём.СтатусЗаписи In ('Проведён', 'Неявка')")
    AddProp qd, "Description", dbText, "Переносит прошедшие приёмы (датой ранее текущей и статусом «Проведён» или «Неявка») в таблицу АрхивЗаписей."
    qd.Close

    ' Q09_ОбновлениеСтатусаПроведён — На обновление (UPDATE). Проставляет статус «Проведён» для
    ' всех записей с датой приёма ранее текущей, если статус остался «Запланирован». Параметры:
    ' без параметров.
    On Error Resume Next
    db.QueryDefs.Delete "Q09_ОбновлениеСтатусаПроведён"
    On Error GoTo 0
    Set qd = db.CreateQueryDef("Q09_ОбновлениеСтатусаПроведён", "UPDATE ЗаписиНаПриём SET ЗаписиНаПриём.СтатусЗаписи = 'Проведён' WHERE ЗаписиНаПриём.ДатаПриёма < Date() AND ЗаписиНаПриём.СтатусЗаписи = 'Запланирован'")
    AddProp qd, "Description", dbText, "Проставляет статус «Проведён» для всех записей с датой приёма ранее текущей, если статус остался «Запланирован»."
    qd.Close

    ' Q10_УдалениеОтменённыхЗаписей — На удаление (DELETE). Удаляет отменённые записи старше 30
    ' дней после очистки архива. Параметры: без параметров.
    On Error Resume Next
    db.QueryDefs.Delete "Q10_УдалениеОтменённыхЗаписей"
    On Error GoTo 0
    Set qd = db.CreateQueryDef("Q10_УдалениеОтменённыхЗаписей", "DELETE ЗаписиНаПриём.* FROM ЗаписиНаПриём WHERE ЗаписиНаПриём.СтатусЗаписи = 'Отменён' AND ЗаписиНаПриём.ДатаПриёма < Date() - 30")
    AddProp qd, "Description", dbText, "Удаляет отменённые записи старше 30 дней после очистки архива."
    qd.Close

    ' Q11_РасписаниеВрачаНаДату — Параметрический. Расписание конкретного врача на выбранную дату
    ' с отметкой о занятости талона. Параметры: [Введите фамилию врача], [Введите дату].
    On Error Resume Next
    db.QueryDefs.Delete "Q11_РасписаниеВрачаНаДату"
    On Error GoTo 0
    Set qd = db.CreateQueryDef("Q11_РасписаниеВрачаНаДату", "PARAMETERS [Введите фамилию врача] Text ( 255 ), [Введите дату] DateTime; SELECT РасписаниеПриёма.ВремяНачала AS Начало, РасписаниеПриёма.ВремяОкончания AS Окончание, РасписаниеПриёма.Кабинет AS Каб, [Пациенты].[Фамилия] & ' ' & Left([Пациенты].[Имя], 1) & '.' AS Пациент, ЗаписиНаПриём.СтатусЗаписи AS Статус, IIf(IsNull([ЗаписиНаПриём].[КодЗаписи]), 'Свободен', 'Занят') AS Состояние FROM (РасписаниеПриёма INNER JOIN Врачи ON РасписаниеПриёма.КодВрача = Врачи.КодВрача) LEFT JOIN (ЗаписиНаПриём LEFT JOIN Пациенты ON ЗаписиНаПриём.КодПациента = Пациенты.КодПациента) ON РасписаниеПриёма.КодРасписания = ЗаписиНаПриём.КодРасписания WHERE Врачи.Фамилия = [Введите фамилию врача] AND РасписаниеПриёма.ДатаПриёма = [Введите дату] ORDER BY РасписаниеПриёма.ВремяНачала")
    AddProp qd, "Description", dbText, "Расписание конкретного врача на выбранную дату с отметкой о занятости талона."
    qd.Close

    ' Q12_ДиагнозыПриёма — Выборка. Диагнозы приёма с расшифровкой по справочнику МКБ-10.
    ' Параметры: без параметров.
    On Error Resume Next
    db.QueryDefs.Delete "Q12_ДиагнозыПриёма"
    On Error GoTo 0
    Set qd = db.CreateQueryDef("Q12_ДиагнозыПриёма", "SELECT Диагнозы.КодЗаписи AS КодЗаписи, ЗаписиНаПриём.НомерТалона AS [№ талона], [Пациенты].[Фамилия] & ' ' & Left([Пациенты].[Имя], 1) & '. ' & Left([Пациенты].[Отчество], 1) & '.' AS Пациент, Диагнозы.КодМКБ AS [Код МКБ], МКБ.Наименование AS Наименование, Диагнозы.ТипДиагноза AS Тип, Диагнозы.ДатаУстановки AS [Дата], Диагнозы.Примечание AS Примечание, МКБ.КлассЗаболеваний AS Класс FROM ((Диагнозы INNER JOIN МКБ ON Диагнозы.КодМКБ = МКБ.КодМКБ) INNER JOIN ЗаписиНаПриём ON Диагнозы.КодЗаписи = ЗаписиНаПриём.КодЗаписи) INNER JOIN Пациенты ON ЗаписиНаПриём.КодПациента = Пациенты.КодПациента ORDER BY ЗаписиНаПриём.ДатаПриёма DESC")
    AddProp qd, "Description", dbText, "Диагнозы приёма с расшифровкой по справочнику МКБ-10."
    qd.Close

    ' Q13_НазначенияПриёма — Выборка с вычисляемыми полями. Лист назначений по приёму с расчётом
    ' стоимости каждой услуги. Параметры: без параметров.
    On Error Resume Next
    db.QueryDefs.Delete "Q13_НазначенияПриёма"
    On Error GoTo 0
    Set qd = db.CreateQueryDef("Q13_НазначенияПриёма", "SELECT Назначения.КодЗаписи AS КодЗаписи, ЗаписиНаПриём.НомерТалона AS [№ талона], Услуги.НазваниеУслуги AS Услуга, Назначения.Количество AS [Кол-во], Услуги.Стоимость AS Цена, [Назначения].[Количество] * [Услуги].[Стоимость] AS Сумма, Назначения.Дозировка AS Дозировка, Назначения.КратностьПрименения AS Кратность, Назначения.Выполнено AS Выполнено FROM (Назначения INNER JOIN Услуги ON Назначения.КодУслуги = Услуги.КодУслуги) INNER JOIN ЗаписиНаПриём ON Назначения.КодЗаписи = ЗаписиНаПриём.КодЗаписи ORDER BY ЗаписиНаПриём.НомерТалона, Услуги.НазваниеУслуги")
    AddProp qd, "Description", dbText, "Лист назначений по приёму с расчётом стоимости каждой услуги."
    qd.Close

    ' Q14_КонтрольПересеченияВремени — Контрольный (выборка). Контроль соблюдения требования
    ' «время приёма не может пересекаться у одного врача»: возвращает записи-дубли по врачу, дате
    ' и времени. Параметры: без параметров.
    On Error Resume Next
    db.QueryDefs.Delete "Q14_КонтрольПересеченияВремени"
    On Error GoTo 0
    Set qd = db.CreateQueryDef("Q14_КонтрольПересеченияВремени", "SELECT ЗаписиНаПриём.КодВрача AS [Код врача], ЗаписиНаПриём.ДатаПриёма AS Дата, ЗаписиНаПриём.ВремяПриёма AS Время, Count(ЗаписиНаПриём.КодЗаписи) AS [Число записей] FROM ЗаписиНаПриём GROUP BY ЗаписиНаПриём.КодВрача, ЗаписиНаПриём.ДатаПриёма, ЗаписиНаПриём.ВремяПриёма HAVING Count(ЗаписиНаПриём.КодЗаписи) > 1")
    AddProp qd, "Description", dbText, "Контроль соблюдения требования «время приёма не может пересекаться у одного врача»: возвращает записи-дубли по врачу, дате и времени."
    qd.Close

    ' Q15_СтатистикаПоСпециальностям — Итоговый. Итоговая статистика приёмов по специальностям —
    ' источник диаграммы загрузки поликлиники. Параметры: без параметров.
    On Error Resume Next
    db.QueryDefs.Delete "Q15_СтатистикаПоСпециальностям"
    On Error GoTo 0
    Set qd = db.CreateQueryDef("Q15_СтатистикаПоСпециальностям", "SELECT Специальности.НазваниеСпециальности AS Специальность, Count(ЗаписиНаПриём.КодЗаписи) AS [Всего записей], Sum(IIf([ЗаписиНаПриём].[СтатусЗаписи] = 'Проведён', 1, 0)) AS Принято, Sum(IIf([ЗаписиНаПриём].[СтатусЗаписи] = 'Запланирован', 1, 0)) AS Запланировано, Sum(IIf([ЗаписиНаПриём].[СтатусЗаписи] = 'Неявка', 1, 0)) AS Неявка FROM (Специальности LEFT JOIN Врачи ON Специальности.КодСпециальности = Врачи.КодСпециальности) LEFT JOIN ЗаписиНаПриём ON Врачи.КодВрача = ЗаписиНаПриём.КодВрача GROUP BY Специальности.НазваниеСпециальности, Специальности.ПорядокОтображения ORDER BY Специальности.ПорядокОтображения")
    AddProp qd, "Description", dbText, "Итоговая статистика приёмов по специальностям — источник диаграммы загрузки поликлиники."
    qd.Close

    ' Q16_ПроверкаВхода — Служебный (авторизация). Проверка учётной записи: логин, пароль, роль,
    ' уровень доступа. Параметры: [Введите логин], [Введите пароль].
    On Error Resume Next
    db.QueryDefs.Delete "Q16_ПроверкаВхода"
    On Error GoTo 0
    Set qd = db.CreateQueryDef("Q16_ПроверкаВхода", "PARAMETERS [Введите логин] Text ( 255 ), [Введите пароль] Text ( 255 ); SELECT Пользователи.КодПользователя AS Код, Пользователи.Логин AS Логин, Пользователи.ФИО AS ФИО, Роли.НазваниеРоли AS Роль, Роли.УровеньДоступа AS Уровень, Пользователи.КодВрача AS КодВрача FROM Пользователи INNER JOIN Роли ON Пользователи.КодРоли = Роли.КодРоли WHERE Пользователи.Логин = [Введите логин] AND Пользователи.Пароль = [Введите пароль] AND Пользователи.Активен = True")
    AddProp qd, "Description", dbText, "Проверка учётной записи: логин, пароль, роль, уровень доступа."
    qd.Close

    LogLine "  создано запросов: 16"
End Sub


