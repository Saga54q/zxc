Private Sub СоздатьИндексы()
    ' Индексы. Уникальный составной индекс IX_Zap_Vrach_Time (КодВрача + ДатаПриёма + ВремяПриёма)
    ' реализует требование «время приёма не может пересекаться у одного врача».
    ' Уникальность времени приёма у одного врача (защита от пересечения талонов)
    Exec "CREATE UNIQUE INDEX IX_Zap_Vrach_Time ON [ЗаписиНаПриём] ([КодВрача], [ДатаПриёма], [ВремяПриёма])"
    ' Уникальность слота расписания
    Exec "CREATE UNIQUE INDEX IX_Rasp_Vrach_Time ON [РасписаниеПриёма] ([КодВрача], [ДатаПриёма], [ВремяНачала])"
    ' Ускорение выборки по пациенту
    Exec "CREATE INDEX IX_Zap_Pacient ON [ЗаписиНаПриём] ([КодПациента])"
    ' Ускорение выборки по дате
    Exec "CREATE INDEX IX_Zap_Data ON [ЗаписиНаПриём] ([ДатаПриёма])"
    ' Ускорение выборки по статусу
    Exec "CREATE INDEX IX_Zap_Status ON [ЗаписиНаПриём] ([СтатусЗаписи])"
    ' Ускорение поиска пациента по фамилии
    Exec "CREATE INDEX IX_Pac_Fam ON [Пациенты] ([Фамилия])"
    ' Ускорение выборки по специальности
    Exec "CREATE INDEX IX_Vrach_Spec ON [Врачи] ([КодСпециальности])"
    ' Ускорение выборки назначений приёма
    Exec "CREATE INDEX IX_Nazn_Zapis ON [Назначения] ([КодЗаписи])"
    ' Ускорение выборки диагнозов приёма
    Exec "CREATE INDEX IX_Diag_Zapis ON [Диагнозы] ([КодЗаписи])"
    ' Ускорение выборки журнала
    Exec "CREATE INDEX IX_Journal_Date ON [ЖурналСобытий] ([ДатаВремя])"
    LogLine "  создано индексов: 10"
End Sub


