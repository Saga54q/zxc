Attribute VB_Name = "AutoBuild"
' ============================================================================
'  МОДУЛЬ АВТОМАТИЧЕСКОГО ПОСТРОЕНИЯ БАЗЫ ДАННЫХ «ПОЛИКЛИНИКА»
'  Дисциплина : Администрирование баз данных (СУБД MS Access)
'  Вариант 14 : предметная область «Поликлиника»
'  Выполнил   : студент группы Р-25-29 Сагадиев А. Р.
'  Проверил   : преподаватель Габитова А. И.                      Уфа, 2026 г.
' ----------------------------------------------------------------------------
'  НАЗНАЧЕНИЕ. Одна процедура СоздатьБД() полностью собирает базу данных:
'    этап 1  - очистка предыдущей версии базы (связи, таблицы, запросы,
'              формы, отчёты, макросы);
'    этап 2  - создание 13 таблиц со всеми типами данных и первичными ключами;
'    этап 3  - установка свойств полей через DAO: значения по умолчанию,
'              условия на значение, маски ввода, подписи столбцов, форматы;
'    этап 4  - создание 12 связей (внешних ключей) с обеспечением ссылочной
'              целостности, каскадным удалением и обновлением;
'    этап 5  - создание 10 индексов, в том числе уникального составного
'              индекса (КодВрача + ДатаПриёма + ВремяПриёма), запрещающего
'              пересечение времени приёма у одного врача;
'    этап 6  - заполнение таблиц тестовыми данными;
'    этап 7  - создание 16 запросов (выборка, параметрические, с вычисляемыми
'              полями, итоговые, на добавление, на обновление, на удаление);
'    этап 8  - создание 7 форм (главная с двумя подчинёнными, форма ввода,
'              ленточная, две подчинённые, авторизация, кнопочная);
'    этап 9  - создание 4 отчётов с группировкой и итогами;
'    этап 10 - загрузка макросов и настройка параметров запуска приложения.
' ----------------------------------------------------------------------------
'  КАК ПОЛЬЗОВАТЬСЯ
'  Вариант А (в 1 клик): запустить скрипт Создать_БД_Поликлиника.vbs.
'  Вариант Б (вручную из Access):
'    1. Создать пустую базу «Поликлиника.accdb».
'    2. Alt+F11 -> Файл -> Импорт файла -> AutoBuild.bas, ModSecurity.bas,
'       ModAdmin.bas.
'    3. Нажать Alt+F8 -> выбрать «СоздатьБД» -> «Выполнить».
' ============================================================================
Option Compare Database
Option Explicit

Private mOk As Long          ' счётчик успешно выполненных операторов
Private mErr As Long         ' счётчик ошибок
Private mLog As String       ' журнал построения


Public Sub СоздатьБД(Optional ByVal БезДиалогов As Boolean = False)
    Dim t0 As Double
    t0 = Timer
    mOk = 0
    mErr = 0
    mLog = ""

    If Not БезДиалогов Then
        If MsgBox("Будет создана база данных «Поликлиника»." & vbCrLf & _
                  "Существующие таблицы, запросы, формы, отчёты и макросы с теми же " & _
                  "именами будут удалены!" & vbCrLf & vbCrLf & "Продолжить?", _
                  vbQuestion + vbYesNo, "Создание БД «Поликлиника»") = vbNo Then Exit Sub
    End If

    LogLine "=== НАЧАЛО ПОСТРОЕНИЯ: " & Now() & " ==="
    LogLine "Этап 1/10: очистка предыдущей версии базы данных"
    ОчиститьБД
    LogLine "Этап 2/10: создание таблиц"
    СоздатьТаблицы
    LogLine "Этап 3/10: установка свойств полей (маски ввода, подписи, проверки)"
    УстановитьСвойстваПолей
    LogLine "Этап 4/10: создание связей (внешних ключей)"
    СоздатьСвязи
    LogLine "Этап 5/10: создание индексов"
    СоздатьИндексы
    LogLine "Этап 6/10: заполнение таблиц тестовыми данными"
    ЗаполнитьДанные
    LogLine "Этап 7/10: создание запросов"
    СоздатьЗапросы
    LogLine "Этап 8/10: создание форм"
    СоздатьФормы
    LogLine "Этап 9/10: создание отчётов"
    СоздатьОтчёты
    LogLine "Этап 10/10: загрузка макросов и настройка запуска"
    СоздатьМакросы
    НастроитьЗапуск

    LogLine "=== ОКОНЧАНИЕ: " & Now() & " ==="
    LogLine "Успешно выполнено операторов SQL: " & CStr(mOk)
    LogLine "Ошибок: " & CStr(mErr)

    If Not БезДиалогов Then
        MsgBox "БАЗА ДАННЫХ «ПОЛИКЛИНИКА» СОЗДАНА!" & vbCrLf & vbCrLf & _
               "Успешно выполнено операторов SQL: " & CStr(mOk) & vbCrLf & _
               "Ошибок: " & CStr(mErr) & vbCrLf & _
               "Время построения, с: " & Format(Timer - t0, "0.0") & vbCrLf & vbCrLf & _
               "Таблиц: 13, запросов: 16, форм: 7, отчётов: 4, макросов: 6.", _
               vbInformation, "Готово"

        If mErr > 0 Then
            If MsgBox("Показать журнал построения (ошибки)?" & vbCrLf & _
                      "Журнал также доступен в окне отладки VBA (Ctrl+G).", _
                      vbYesNo + vbQuestion, "Построение завершено") = vbYes Then
                MsgBox mLog, vbInformation, "Журнал построения"
            End If
        End If
    End If
End Sub

Public Sub ПоказатьСтатистику()
    Dim s As String
    s = "Состав базы данных «Поликлиника»:" & vbCrLf & vbCrLf
    s = s & "Специальностей:    " & DCount("*", "Специальности") & vbCrLf
    s = s & "Врачей:            " & DCount("*", "Врачи") & vbCrLf
    s = s & "Пациентов:         " & DCount("*", "Пациенты") & vbCrLf
    s = s & "Услуг:             " & DCount("*", "Услуги") & vbCrLf
    s = s & "Слотов расписания: " & DCount("*", "РасписаниеПриёма") & vbCrLf
    s = s & "Записей на приём:  " & DCount("*", "ЗаписиНаПриём") & vbCrLf
    s = s & "Диагнозов:         " & DCount("*", "Диагнозы") & vbCrLf
    s = s & "Назначений:        " & DCount("*", "Назначения") & vbCrLf
    s = s & "Пользователей:     " & DCount("*", "Пользователи") & vbCrLf
    MsgBox s, vbInformation, "Статистика базы данных"
End Sub


' ============================================================================
'  ЭТАП 2. СОЗДАНИЕ ТАБЛИЦ
' ============================================================================

Private Sub СоздатьТаблицы()
    ' Создание таблиц. Оператор DROP удаляет предыдущую версию таблицы; ошибка удаления (таблицы
    ' нет) игнорируется.

    ' Специальности — Справочник врачебных специальностей поликлиники
    ExecSilent "DROP TABLE [Специальности]"
    Exec "CREATE TABLE [Специальности] ([КодСпециальности] COUNTER CONSTRAINT PK_Специальности PRIMARY KEY, [НазваниеСпециальности] TEXT(60) NOT NULL UNIQUE, [Описание] MEMO, [ПорядокОтображения] LONG);"

    ' Врачи — Справочник врачей поликлиники
    ExecSilent "DROP TABLE [Врачи]"
    Exec "CREATE TABLE [Врачи] ([КодВрача] COUNTER CONSTRAINT PK_Врачи PRIMARY KEY, [Фамилия] TEXT(40) NOT NULL, [Имя] TEXT(40) NOT NULL, [Отчество] TEXT(40), [КодСпециальности] LONG NOT NULL, [Кабинет] TEXT(10), [Телефон] TEXT(20), [ДатаПриёмаНаРаботу] DATETIME, [Категория] TEXT(30));"

    ' Пациенты — Картотека пациентов поликлиники
    ExecSilent "DROP TABLE [Пациенты]"
    Exec "CREATE TABLE [Пациенты] ([КодПациента] COUNTER CONSTRAINT PK_Пациенты PRIMARY KEY, [Фамилия] TEXT(40) NOT NULL, [Имя] TEXT(40) NOT NULL, [Отчество] TEXT(40), [ДатаРождения] DATETIME NOT NULL, [Пол] TEXT(1) NOT NULL, [Адрес] TEXT(120), [Телефон] TEXT(20), [НомерПолиса] TEXT(20) NOT NULL UNIQUE, [ДатаРегистрации] DATETIME, [Участок] LONG);"

    ' Услуги — Прейскурант медицинских услуг поликлиники
    ExecSilent "DROP TABLE [Услуги]"
    Exec "CREATE TABLE [Услуги] ([КодУслуги] COUNTER CONSTRAINT PK_Услуги PRIMARY KEY, [КодСпециальности] LONG NOT NULL, [НазваниеУслуги] TEXT(80) NOT NULL, [Стоимость] CURRENCY NOT NULL, [ДлительностьМинут] LONG);"

    ' МКБ — Справочник диагнозов МКБ-10 (сокращённая версия)
    ExecSilent "DROP TABLE [МКБ]"
    Exec "CREATE TABLE [МКБ] ([КодМКБ] TEXT(6) CONSTRAINT PK_МКБ PRIMARY KEY, [Наименование] TEXT(200) NOT NULL, [КлассЗаболеваний] TEXT(80));"

    ' РасписаниеПриёма — Сетка талонов (слотов) приёма врачей
    ExecSilent "DROP TABLE [РасписаниеПриёма]"
    Exec "CREATE TABLE [РасписаниеПриёма] ([КодРасписания] COUNTER CONSTRAINT PK_РасписаниеПриёма PRIMARY KEY, [КодВрача] LONG NOT NULL, [ДатаПриёма] DATETIME NOT NULL, [ВремяНачала] DATETIME NOT NULL, [ВремяОкончания] DATETIME NOT NULL, [Кабинет] TEXT(10), [ДлительностьМинут] LONG, [ПризнакПриёма] YESNO);"

    ' ЗаписиНаПриём — Журнал записи пациентов на приём (талоны)
    ExecSilent "DROP TABLE [ЗаписиНаПриём]"
    Exec "CREATE TABLE [ЗаписиНаПриём] ([КодЗаписи] COUNTER CONSTRAINT PK_ЗаписиНаПриём PRIMARY KEY, [НомерТалона] TEXT(20) NOT NULL UNIQUE, [КодПациента] LONG NOT NULL, [КодВрача] LONG NOT NULL, [КодРасписания] LONG, [ДатаПриёма] DATETIME NOT NULL, [ВремяПриёма] DATETIME NOT NULL, [СтатусЗаписи] TEXT(20) NOT NULL, [Жалобы] MEMO, [ДатаСоздания] DATETIME);"

    ' Диагнозы — Диагнозы, установленные в рамках приёма
    ExecSilent "DROP TABLE [Диагнозы]"
    Exec "CREATE TABLE [Диагнозы] ([КодДиагноза] COUNTER CONSTRAINT PK_Диагнозы PRIMARY KEY, [КодЗаписи] LONG NOT NULL, [КодМКБ] TEXT(6) NOT NULL, [ТипДиагноза] TEXT(20), [ДатаУстановки] DATETIME, [Примечание] TEXT(255));"

    ' Назначения — Назначенные услуги, исследования и лечение
    ExecSilent "DROP TABLE [Назначения]"
    Exec "CREATE TABLE [Назначения] ([КодНазначения] COUNTER CONSTRAINT PK_Назначения PRIMARY KEY, [КодЗаписи] LONG NOT NULL, [КодУслуги] LONG NOT NULL, [Количество] LONG NOT NULL, [Дозировка] TEXT(60), [КратностьПрименения] TEXT(60), [ДатаНазначения] DATETIME, [Выполнено] YESNO);"

    ' Роли — Роли пользователей системы
    ExecSilent "DROP TABLE [Роли]"
    Exec "CREATE TABLE [Роли] ([КодРоли] COUNTER CONSTRAINT PK_Роли PRIMARY KEY, [НазваниеРоли] TEXT(30) NOT NULL UNIQUE, [Описание] MEMO, [УровеньДоступа] LONG NOT NULL);"

    ' Пользователи — Учётные записи сотрудников (администрирование доступа)
    ExecSilent "DROP TABLE [Пользователи]"
    Exec "CREATE TABLE [Пользователи] ([КодПользователя] COUNTER CONSTRAINT PK_Пользователи PRIMARY KEY, [Логин] TEXT(30) NOT NULL UNIQUE, [Пароль] TEXT(40) NOT NULL, [ФИО] TEXT(80) NOT NULL, [КодРоли] LONG NOT NULL, [КодВрача] LONG, [Активен] YESNO);"

    ' АрхивЗаписей — Служебная таблица архива прошедших приёмов (заполняется запросом Q08)
    ExecSilent "DROP TABLE [АрхивЗаписей]"
    Exec "CREATE TABLE [АрхивЗаписей] ([КодАрхива] COUNTER CONSTRAINT PK_АрхивЗаписей PRIMARY KEY, [КодЗаписи] LONG NOT NULL, [НомерТалона] TEXT(20), [КодПациента] LONG, [КодВрача] LONG, [ДатаПриёма] DATETIME, [ВремяПриёма] DATETIME, [СтатусЗаписи] TEXT(20), [Жалобы] MEMO, [ДатаАрхивации] DATETIME);"

    ' ЖурналСобытий — Журнал аудита действий пользователей
    ExecSilent "DROP TABLE [ЖурналСобытий]"
    Exec "CREATE TABLE [ЖурналСобытий] ([КодСобытия] COUNTER CONSTRAINT PK_ЖурналСобытий PRIMARY KEY, [ДатаВремя] DATETIME, [Логин] TEXT(30), [Действие] TEXT(80), [ОбъектДействия] TEXT(80), [Результат] TEXT(30));"
    LogLine "  создано таблиц: 13"
End Sub


' ============================================================================
'  ЭТАП 3. СВОЙСТВА ПОЛЕЙ
' ============================================================================

Private Sub УстановитьСвойстваПолей()
    ' Значения по умолчанию, условия и сообщения проверки, маски ввода, подписи и форматы полей
    ' через объектную модель DAO.
    Dim db As DAO.Database
    Dim tdf As DAO.TableDef
    Dim fld As DAO.Field
    Set db = CurrentDb
    On Error Resume Next

    ' Таблица «Специальности»
    Set tdf = db.TableDefs("Специальности")
    Set fld = tdf.Fields("НазваниеСпециальности")
    AddProp fld, "Caption", dbText, "Специальность"
    fld.ValidationRule = "Len([НазваниеСпециальности]) >= 3"
    fld.ValidationText = "Название специальности должно содержать не менее 3 символов"

    ' Таблица «Врачи»
    Set tdf = db.TableDefs("Врачи")
    Set fld = tdf.Fields("Телефон")
    AddProp fld, "InputMask", dbText, "8\-900\-000\-00\-00;0;_"
    AddProp fld, "Caption", dbText, "Телефон"
    Set fld = tdf.Fields("Кабинет")
    AddProp fld, "InputMask", dbText, "###;0;_"
    AddProp fld, "Caption", dbText, "Кабинет"
    fld.ValidationRule = "Len([Кабинет]) >= 1"
    fld.ValidationText = "Укажите номер кабинета"
    Set fld = tdf.Fields("Категория")
    fld.DefaultValue = """Без категории"""

    ' Таблица «Пациенты»
    Set tdf = db.TableDefs("Пациенты")
    Set fld = tdf.Fields("Пол")
    fld.DefaultValue = """М"""
    fld.ValidationRule = "In (""М"";""Ж"")"
    fld.ValidationText = "Пол указывается буквой М или Ж"
    Set fld = tdf.Fields("Телефон")
    AddProp fld, "InputMask", dbText, "8\-900\-000\-00\-00;0;_"
    Set fld = tdf.Fields("НомерПолиса")
    AddProp fld, "InputMask", dbText, "0000\ 0000\ 0000;0;_"
    AddProp fld, "Caption", dbText, "Полис ОМС"
    Set fld = tdf.Fields("ДатаРождения")
    AddProp fld, "Format", dbText, "Short Date"
    AddProp fld, "Caption", dbText, "Дата рождения"
    Set fld = tdf.Fields("ДатаРегистрации")
    AddProp fld, "Format", dbText, "Short Date"
    fld.DefaultValue = "Date()"
    Set fld = tdf.Fields("Участок")
    fld.ValidationRule = "Between 1 And 12"
    fld.ValidationText = "Номер участка должен быть от 1 до 12"

    ' Таблица «Услуги»
    Set tdf = db.TableDefs("Услуги")
    Set fld = tdf.Fields("Стоимость")
    AddProp fld, "Format", dbText, "# ##0.00"
    AddProp fld, "Caption", dbText, "Стоимость, руб."
    fld.DefaultValue = "0"
    fld.ValidationRule = ">=0"
    fld.ValidationText = "Стоимость услуги не может быть отрицательной"
    Set fld = tdf.Fields("ДлительностьМинут")
    fld.DefaultValue = "15"
    fld.ValidationRule = "Between 5 And 180"
    fld.ValidationText = "Длительность услуги от 5 до 180 минут"

    ' Таблица «МКБ»
    Set tdf = db.TableDefs("МКБ")
    Set fld = tdf.Fields("КодМКБ")
    AddProp fld, "InputMask", dbText, ">L00.0;;_"
    AddProp fld, "Caption", dbText, "Код МКБ-10"

    ' Таблица «РасписаниеПриёма»
    Set tdf = db.TableDefs("РасписаниеПриёма")
    Set fld = tdf.Fields("ДатаПриёма")
    AddProp fld, "Format", dbText, "Short Date"
    Set fld = tdf.Fields("ВремяНачала")
    AddProp fld, "Format", dbText, "Short Time"
    AddProp fld, "Caption", dbText, "Начало"
    Set fld = tdf.Fields("ВремяОкончания")
    AddProp fld, "Format", dbText, "Short Time"
    AddProp fld, "Caption", dbText, "Окончание"
    Set fld = tdf.Fields("ДлительностьМинут")
    fld.DefaultValue = "30"
    Set fld = tdf.Fields("ПризнакПриёма")
    fld.DefaultValue = "True"

    ' Таблица «ЗаписиНаПриём»
    Set tdf = db.TableDefs("ЗаписиНаПриём")
    Set fld = tdf.Fields("НомерТалона")
    AddProp fld, "Caption", dbText, "№ талона"
    Set fld = tdf.Fields("ДатаПриёма")
    AddProp fld, "Format", dbText, "Short Date"
    AddProp fld, "Caption", dbText, "Дата приёма"
    Set fld = tdf.Fields("ВремяПриёма")
    AddProp fld, "Format", dbText, "Short Time"
    AddProp fld, "Caption", dbText, "Время"
    fld.ValidationRule = ">= #08:00:00# And <= #20:00:00#"
    fld.ValidationText = "Время приёма должно быть с 08:00 до 20:00"
    Set fld = tdf.Fields("СтатусЗаписи")
    fld.ValidationRule = "In (""Запланирован"";""Проведён"";""Отменён"";""Неявка"")"
    fld.ValidationText = "Допустимые статусы: Запланирован, Проведён, Отменён, Неявка"
    fld.DefaultValue = """Запланирован"""
    Set fld = tdf.Fields("ДатаСоздания")
    fld.DefaultValue = "Now()"

    ' Таблица «Диагнозы»
    Set tdf = db.TableDefs("Диагнозы")
    Set fld = tdf.Fields("ТипДиагноза")
    fld.DefaultValue = """Основной"""
    fld.ValidationRule = "In (""Основной"";""Сопутствующий"";""Предварительный"")"
    Set fld = tdf.Fields("ДатаУстановки")
    AddProp fld, "Format", dbText, "Short Date"

    ' Таблица «Назначения»
    Set tdf = db.TableDefs("Назначения")
    Set fld = tdf.Fields("Количество")
    fld.DefaultValue = "1"
    fld.ValidationRule = "Between 1 And 50"
    fld.ValidationText = "Количество должно быть от 1 до 50"
    Set fld = tdf.Fields("ДатаНазначения")
    AddProp fld, "Format", dbText, "Short Date"
    fld.DefaultValue = "Date()"
    Set fld = tdf.Fields("Выполнено")
    fld.DefaultValue = "False"

    ' Таблица «Роли»
    Set tdf = db.TableDefs("Роли")
    Set fld = tdf.Fields("УровеньДоступа")
    fld.DefaultValue = "1"
    fld.ValidationRule = "Between 1 And 3"

    ' Таблица «Пользователи»
    Set tdf = db.TableDefs("Пользователи")
    Set fld = tdf.Fields("Активен")
    fld.DefaultValue = "True"

    ' Таблица «АрхивЗаписей»
    Set tdf = db.TableDefs("АрхивЗаписей")
    Set fld = tdf.Fields("ДатаАрхивации")
    AddProp fld, "Format", dbText, "Short Date"
    fld.DefaultValue = "Date()"

    ' Таблица «ЖурналСобытий»
    Set tdf = db.TableDefs("ЖурналСобытий")
    Set fld = tdf.Fields("ДатаВремя")
    AddProp fld, "Format", dbText, "General Date"
    fld.DefaultValue = "Now()"
    Set fld = tdf.Fields("Результат")
    fld.DefaultValue = """Успешно"""

    On Error GoTo 0
    LogLine "  свойства полей (маски ввода, подписи, проверки) установлены"
End Sub


' ============================================================================
'  ЭТАП 4. СВЯЗИ (ВНЕШНИЕ КЛЮЧИ)
' ============================================================================

Private Sub СоздатьСвязи()
    ' Связи между таблицами с обеспечением ссылочной целостности.
    Dim db As DAO.Database
    Dim rel As DAO.Relation
    Set db = CurrentDb
    On Error Resume Next

    ' Связь FK_Врачи_Специальности: Врачи.[КодСпециальности] -> Специальности.[КодСпециальности]
    ' (при удалении: CASCADE)
    Set rel = db.CreateRelation("FK_Врачи_Специальности", "Специальности", "Врачи", dbRelationUpdateCascade)
    rel.Fields.Append rel.CreateField("КодСпециальности")
